PORT=3000
HOST=0.0.0.0
# Generar con npm run setup. Nunca usar una contraseña incluida en el repositorio.
ADMIN_PASSWORD=
DATABASE_PATH=.data/cinaptic.sqlite
# En Vercel, conectar Neon/PostgreSQL y configurar DATABASE_URL (no usar SQLite).
DATABASE_URL=
# También se reconocen STORAGE_DATABASE_URL, STORAGE_POSTGRES_URL,
# STORAGE_POSTGRES_PRISMA_URL y STORAGE_DATABASE_URL_UNPOOLED de Neon/Vercel.
# En producción con HTTPS, establecer true.
COOKIE_SECURE=false
